# Supabase. The anon key is public. The service role key stays on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apple Music. All three are required to save a playlist and to load album art.
# APPLE_PRIVATE_KEY is the MusicKit .p8 file. Newlines can be written as \n.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional absolute site URL for share links when no request host is available.
NEXT_PUBLIC_SITE_URL=
