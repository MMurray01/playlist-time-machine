# Supabase. The anon key is public. The service role key stays on the server.
# After supabase/migrations/20261016130000_share_playlist_functions.sql is applied,
# share links use the anon key and the service role key is not used for sharing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apple Music. All three are required to save a playlist and to load album art.
# APPLE_PRIVATE_KEY is the MusicKit .p8 file. Newlines can be written as \n.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional absolute site URL for share links when no request host is available.
NEXT_PUBLIC_SITE_URL=

# Apple Services Performance Partners affiliate token (Partnerize partner token).
# When set, music.apple.com links gain at=, ct=, app=music, and ls=1, plus an affiliate disclosure.
# Leave empty until the token exists. This is not a public NEXT_PUBLIC_ variable.
APPLE_AFFILIATE_TOKEN=

# Google Analytics 4 measurement id, such as G-XXXXXXXX. Leave empty to skip the tag.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML verification token. Optional.
# A DNS TXT record on the domain works too and does not need this variable.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional Upstash Redis REST credentials. Sharing works when these are empty.
# When both are set, new share links are limited to 10 per IP per hour.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
