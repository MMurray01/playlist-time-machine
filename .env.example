# Supabase. The anon key is public. The service role key stays on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spotify. Use SPOTIFY_CLIENT_ID or NEXT_PUBLIC_SPOTIFY_CLIENT_ID.
# The secret lets the site look up album art before someone signs in.
SPOTIFY_CLIENT_ID=
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional. Defaults to {your-site}/callback
# Also supported: {your-site}/api/spotify/callback
SPOTIFY_REDIRECT_URI=

# Apple Music. All three are required. If any are missing, Apple Music stays hidden.
# APPLE_PRIVATE_KEY is the MusicKit .p8 file. Newlines can be written as \n.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional absolute site URL for share links when no request host is available.
NEXT_PUBLIC_SITE_URL=
